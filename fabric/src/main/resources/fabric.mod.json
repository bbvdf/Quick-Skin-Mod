{
  "schemaVersion": 1,
  "id": "onlineskins",
  "version": "${version}",
  "name": "OnlineSkins",
  "description": "Change, preview, and synchronize local skins, capes, and CPM models in-game across Fabric and Forge.",
  "authors": [
    "The Plum Team"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/quick-skin",
    "sources": "https://github.com/The-Plum-Team/Quick-Skin-Mod",
    "issues": "https://github.com/The-Plum-Team/Quick-Skin-Mod/issues"
  },
  "license": "All Rights Reserved",
  "icon": "icon.png",
  "accessWidener": "quick-skin.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.onlineskins.mod.fabric.QuickSkinFabric"
    ],
    "client": [
      "com.onlineskins.mod.fabric.QuickSkinFabricClient"
    ]
  },
  "mixins": [
    "onlineskins.mixins.json",
    "onlineskins-ears.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "fabric-api": "*",
    "minecraft": "=1.20.1",
    "architectury": ">=9.2.14"
  }
}
